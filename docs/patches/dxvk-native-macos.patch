diff --git a/meson.build b/meson.build
index d828de5..a8bf407 100644
--- a/meson.build
+++ b/meson.build
@@ -198,6 +198,12 @@ glsl_args = [
 if get_option('debug')
   glsl_args += ['-gVS']
 endif
+if host_machine.system() == 'darwin'
+  # mac-port: MoltenVK/SPIRV-Cross, bir texture'ı depth-compare (shadow) ile
+  # kullanınca onu depth2d'ye terfi ettirir ve renk sample()'ı skaler döndürür
+  # (tüm texture'lar gri). FF shader'da shadow yolunu bu define ile kapatıyoruz.
+  glsl_args += ['-DDXVK_MACOS=1']
+endif
 glsl_generator = generator(
   glsl_compiler,
   output    : [ '@BASENAME@.h' ],
